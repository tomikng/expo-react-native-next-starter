{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@my/ui": ["../../packages/ui/src"],
      "@my/ui/*": ["../../packages/ui/src/*"],
      "@my/config": ["../../packages/config/src"],
      "@my/config/*": ["../../packages/config/src/*"],
      "app": ["../../packages/app"],
      "app/*": ["../../packages/app/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
